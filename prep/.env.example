# Required ------------------------------------------------------------
# MongoDB Atlas connection string (free M0 cluster is plenty)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Passcode to open the app. In production nobody can sign in until this is set.
APP_PASSCODE=

# Optional --------------------------------------------------------------
MONGODB_DB=block26
# Signs the login cookie. Defaults to a value derived from APP_PASSCODE.
SESSION_SECRET=
# Locks the reminder endpoint to Vercel Cron / your GitHub workflow (sent as a Bearer token).
CRON_SECRET=
# Push keys. If unset, a key pair is generated once and stored in MongoDB.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
