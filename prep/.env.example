# MongoDB Atlas connection string (free M0 cluster is plenty)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=block26

# Passcode to open the app. Leave empty only for local development.
APP_PASSCODE=
# Any long random string; signs the login cookie.
SESSION_SECRET=

# Push reminders. Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron sends this as a Bearer token to /api/cron/remind
CRON_SECRET=
